    "name": "API MySQL NodeJS",
    "description": "Colección de endpoints para Usuarios, Lecturas y Pagos (Node.js + MySQL)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Listar usuarios",
          "request": { "method": "GET", "url": "http://localhost:3000/api/usuarios" }
        },
        {
          "name": "Obtener usuario por ID",
          "request": { "method": "GET", "url": "http://localhost:3000/api/usuarios/1" }
        },
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos Ramírez\",\n  \"email\": \"carlos@example.com\",\n  \"fecha_nacimiento\": \"1990-12-15\"\n}"
            },
            "url": "http://localhost:3000/api/usuarios"
          }
        },
        {
          "name": "Actualizar usuario (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos Actualizado\",\n  \"email\": \"carlos.actualizado@example.com\",\n  \"fecha_nacimiento\": \"1990-12-15\",\n \"Estado\": \"Inactivo\"\n }"
            },
            "url": "http://localhost:3000/api/usuarios/1"
          }
        },
        {
          "name": "Actualizar estado usuario (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"estado\": 0 }"
            },
            "url": "http://localhost:3000/api/usuarios/1"
          }
        },
        {
          "name": "Eliminar usuario",
          "request": { "method": "DELETE", "url": "http://localhost:3000/api/usuarios/1" }
        }
      ]
    },
