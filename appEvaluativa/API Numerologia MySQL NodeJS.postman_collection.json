    {
      "name": "Pagos",
      "item": [
        {
          "name": "Listar pagos",
          "request": { "method": "GET", "url": "http://localhost:3000/api/pagos" }
        },
        {
          "name": "Obtener pago por usuario",
          "request": { "method": "GET", "url": "http://localhost:3000/api/pagos/1" }
        },
        {
          "name": "Obtener estado de pago",
          "request": { "method": "GET", "url": "http://localhost:3000/api/pagos/estado/1" }
        },
        {
          "name": "Crear pago",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario_id\": 1,\n  \"monto\": 42000,\n  \"metodo\": \"transferencia\",\n }"
            },
            "url": "http://localhost:3000/api/pagos"
          }
        },
        {
          "name": "Actualizar pago (PUT)",
          "request": {
